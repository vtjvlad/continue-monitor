<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Continue Monitor</title>
  <link rel="stylesheet" href="./styles.css">
</head>
<body>
  <main class="container">
    <header>
      <div>
        <h1>Continue Monitor</h1>
        <p class="muted">Мониторинг сессий и процессов</p>
      </div>
      <button id="refresh">Обновить</button>
    </header>

    <section id="login" class="panel">
      <h2>Авторизация</h2>
      <form id="login-form">
        <input id="token" type="password" placeholder="Токен доступа"
          autocomplete="current-password" required>
        <button type="submit">Войти</button>
      </form>
      <p id="login-error" class="error"></p>
    </section>

    <section id="dashboard" hidden>
      <div class="stats">
        <article class="panel">
          <span class="muted">Сессии в истории</span>
          <strong id="session-count">—</strong>
        </article>
        <article class="panel">
          <span class="muted">Процессы CLI</span>
          <strong id="process-count">—</strong>
        </article>
        <article class="panel">
          <span class="muted">Мониторинг</span>
          <strong id="monitor-state">—</strong>
        </article>
      </div>

      <section class="panel">
        <h2>Сессии Continue</h2>
        <p class="muted">Наличие сессии в истории не означает, что она выполняется.</p>
        <div id="sessions" class="items"></div>
      </section>

      <section class="panel">
        <h2>Процессы Continue CLI</h2>
        <div id="processes" class="items"></div>
      </section>

      <footer class="muted">
        <span id="updated">Ожидание данных…</span>
        <button id="logout" class="secondary">Выйти</button>
      </footer>
    </section>
  </main>
  <script src="./app.js" defer></script>
</body>
</html>
